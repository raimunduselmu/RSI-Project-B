# ====== Umum ======
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000

# ====== Database (SQL Server) ======
DB_HOST=localhost
DB_PORT=1433
DB_NAME=kmk_uns
DB_USER=sa
DB_PASSWORD=GantiPassword!123
DB_ENCRYPT=false                 # true untuk Azure SQL (Opsi B)
DB_TRUST_CERT=true

# ====== Auth ======
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false              # true bila diakses lewat HTTPS
BCRYPT_COST=12

# ====== Seeder ======
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_DEMO=true
SEED_DEMO_PASSWORD=demo1234

# ====== Email (Gmail SMTP App Password) ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kmkuns@gmail.com
SMTP_PASS=app-password-16-digit
MAIL_FROM="KMK UNS <kmkuns@gmail.com>"

# ====== Penyimpanan file ======
STORAGE_DRIVER=local             # local (Opsi A) | blob (Opsi B)
UPLOAD_DIR=./uploads
BLOB_READ_WRITE_TOKEN=

# ====== Penjadwal ======
CRON_ENABLED=true                # false di Vercel (Opsi B)
INTERNAL_CRON_SECRET=ganti-secret-cron
