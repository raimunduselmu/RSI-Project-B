+      .then(([t, ...rest]) => setCounts({ total: t, ...Object.fromEntries(STATUS_KEYS.map((k, i) => [k, rest[i]])) } as Counts))
+      .catch((e) => setError(e as ApiError));
+  }, []);
+  return { counts, error };
