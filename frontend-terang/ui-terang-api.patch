@@ -0,0 +1,36 @@
+import { useCallback, useEffect, useState } from 'react';
+import { api, ApiError, type Paginated } from '@/lib/api';
+
+/** Ambil daftar berhalaman (envelope { data, meta }). Panggil reload() setelah mutasi. */
+export function usePaged<T>(path: string | null) {
+  const [res, setRes] = useState<Paginated<T> | null>(null);
+  const [error, setError] = useState<ApiError | null>(null);
+  const [loading, setLoading] = useState(!!path);
+
+  const reload = useCallback(async () => {
+    if (!path) return;
+    setLoading(true);
+    setError(null);
+    try {
+      setRes(await api.page<T>(path));
+    } catch (e) {
+      setError(e as ApiError);
+    } finally {
+      setLoading(false);
+    }
+  }, [path]);
+
+  useEffect(() => {
+    reload();
+  }, [reload]);
+
+  return { rows: res?.data ?? [], meta: res?.meta ?? null, error, loading, reload };
+}
+
+/** Susun query string, buang nilai kosong. */
+export const qs = (o: Record<string, string | number | undefined | null>) => {
+  const p = new URLSearchParams();
+  Object.entries(o).forEach(([k, v]) => v !== undefined && v !== null && v !== '' && p.set(k, String(v)));
+  const s = p.toString();
+  return s ? `?${s}` : '';
+};
diff --git a/frontend/src/hooks/useReveal.ts b/frontend/src/hooks/useReveal.ts
new file mode 100644
index 0000000..1a8d7ff
--- /dev/null
+++ b/frontend/src/hooks/useReveal.ts
@@ -0,0 +1,28 @@
+import { useEffect, useRef } from 'react';
+
+/** Tambahkan kelas `is-visible` ke elemen `.reveal` di dalam ref saat terlihat (scroll). */
+export function useReveal<T extends HTMLElement>() {
+  const ref = useRef<T>(null);
+  useEffect(() => {
+    const root = ref.current;
+    if (!root) return;
+    const items = root.querySelectorAll<HTMLElement>('.reveal');
+    if (!('IntersectionObserver' in window)) {
+      items.forEach((el) => el.classList.add('is-visible'));
+      return;
+    }
+    const io = new IntersectionObserver(
+      (entries) =>
+        entries.forEach((e) => {
+          if (e.isIntersecting) {
+            e.target.classList.add('is-visible');
+            io.unobserve(e.target);
+          }
+        }),
+      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
+    );
+    items.forEach((el) => io.observe(el));
+    return () => io.disconnect();
+  }, []);
+  return ref;
+}
