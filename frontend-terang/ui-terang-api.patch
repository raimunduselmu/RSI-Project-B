+
+export type IconName = keyof typeof PATHS;
+
+interface Props extends Omit<SVGProps<SVGSVGElement>, 'name'> {
+  name: IconName;
+  size?: number;
+}
+
+export function Icon({ name, size = 18, className, ...rest }: Props) {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      width={size}
+      height={size}
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={1.8}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden="true"
+      className={className}
+      {...rest}
+    >
+      {(PATHS[name] as Node[]).map(([Tag, attr], i) => {
+        const El = Tag as 'path';
+        return <El key={i} {...(attr as SVGProps<SVGPathElement>)} />;
+      })}
+    </svg>
+  );
+}
